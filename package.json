{
  "name": "toyota-tis-downloader",
  "version": "0.1.0",
  "description": "Electron desktop app for downloading Toyota TIS service information through the user's authenticated session.",
  "author": "FuriousDread",
  "main": "dist/src/app/main.js",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win nsis",
    "package:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "xml-js": "1.6.11"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "44.1.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "io.github.FuriousDread.toyota-tis-downloader",
    "productName": "Toyota TIS Downloader",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/ui/**/*",
      "accessor/**/*",
      "LICENSE",
      "NOTICE.md",
      "package.json"
    ],
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
